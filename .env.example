# Copy to .env.local and fill in your Supabase project values.
# Get these from Supabase → Project Settings → API, or from Vercel env vars.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Dev tools in Settings (local only — never true in production)
VITE_DEV_MODE=true
